<article>
  <% if (isArchive) { %>
    <h2><%- include('crazy-link', {link, text: title}) %></h2>
  <% } else { %>
    <h1><%- title %></h1>
  <% } %>
  <div class='meta'>
    <%= formatDate(date, 'MMMM d, yyyy') %> • <%= type %>
  </div>
  <%- _content %>
  <% const image = `${_url.replace(/\/$/, '')}.jpg`; %>
  <% if (fileExists(image)) { %>
    <a href='<%= link %>' class='stealth'>
      <%- imageSet(image, 'thumbnail'); %>
    </a>
  <% } %>
</article>
